# Dockerfile for Intel CPUs/GPUs and NPUs (OpenVINO)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3.12 \
    python3-pip \
    python3.12-venv \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libtbb12 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
# Install onnxruntime-openvino instead of standard onnxruntime
RUN sed -i 's/onnxruntime==/onnxruntime-openvino==/' requirements.txt && \
    pip3 install --no-cache-dir -r requirements.txt

COPY detector/ ./detector/

ENTRYPOINT ["python3.12", "detector/zmq_onnx_client.py"]
CMD ["--endpoint", "tcp://*:5555", "--model", "AUTO"]
