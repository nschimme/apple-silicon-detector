# Dockerfile for AMD GPUs (ROCm)
FROM rocm/dev-ubuntu-22.04:6.2

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    software-properties-common && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    python3.11-venv \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
# Install onnxruntime-rocm instead of standard onnxruntime
# Note: AMD often requires specific wheels or repositories,
# but onnxruntime-rocm is the standard target.
RUN sed -i 's/onnxruntime==/onnxruntime-rocm==/' requirements.txt && \
    pip3 install --no-cache-dir -r requirements.txt

COPY detector/ ./detector/

ENTRYPOINT ["python3", "detector/zmq_onnx_client.py"]
CMD ["--endpoint", "tcp://*:5555", "--model", "AUTO"]
